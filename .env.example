POSTGRES_DB=contacts_db
POSTGRES_USER=contacts_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432
API_PORT=8000
DATABASE_URL=postgresql+psycopg://contacts_user:change_this_password@localhost:5432/contacts_db
REDIS_URL=redis://localhost:6379/0
USER_CACHE_TTL_SECONDS=900

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
JWT_ISSUER=secure-contact-api
JWT_AUDIENCE=secure-contact-api-users
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30

# Use "console" for local development or "smtp" for real email delivery.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true
API_BASE_URL=http://localhost:8000
FRONTEND_RESET_URL=http://localhost:3000/reset-password
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=contact-api/avatars
MAX_AVATAR_BYTES=5242880
ME_RATE_LIMIT_REQUESTS=5
ME_RATE_LIMIT_WINDOW_SECONDS=60